package mongodb;

import java.util.List;

import org.springframework.stereotype.Service;

@Service
public class AlunoService {
	private final AlunoRepository repository;
	
	public AlunoService(AlunoRepository repository) {
		this.repository = repository;
	}
				
		public List<Aluno> tudo(){
			return repository.findAll();
		}
		public Aluno insertAluno(Aluno aluno) {
			return repository.save(aluno);
		}
		
		public Aluno findByCurso(Aluno curso) {
			return repository.findMany(curso);
		}
		
		public List<Aluno> insertManyAlunos(List<Aluno> alunos) {
			return repository.saveAll(alunos);
		}
		
		public Aluno update(String id, Aluno newAluno ) {
			newAluno.setId(id);
			return repository.save(newAluno);
		}
}
	
